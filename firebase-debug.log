[debug] [2026-09-09T09:28:01.584Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/lcqui-uenf:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // --- Funções Auxiliares ---\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n\n    function hasRole(role) {\n      // A role é passada como Custom Claim no token na array 'roles'\n      return isAuthenticated() && request.auth.token.get('roles', []).hasAny([role]);\n    }\n\n    function isAdmin() {\n      return hasRole('Chefe_Geral');\n    }\n\n    // --- Default Fechado ---\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    // --- Usuarios ---\n    match /Usuarios/{uid} {\n      // Usuário lê a si mesmo, chefe lê todos\n      allow read: if isOwner(uid) || isAdmin();\n      // Escrita principal é feita via Cloud Function\n      allow write: if isAdmin();\n\n      match /Turmas/{turmaId} {\n        allow read: if isOwner(uid) || isAdmin();\n        allow write: if false; \n      }\n      match /Notificacoes/{notifId} {\n        allow read: if isOwner(uid);\n        allow update, delete: if isOwner(uid); \n        allow create: if false; // Backend quem cria\n      }\n    }\n\n    // --- Coleções de Papéis (Identidade) ---\n    match /Professor/{uid} {\n      allow read: if isAuthenticated();\n      allow write: if false; // Gerenciado via Cloud Function\n    }\n    match /Aluno/{uid} {\n      allow read: if isAuthenticated();\n      allow write: if false; // Gerenciado via Cloud Function\n    }\n    match /Chefe_Geral/{uid} {\n      allow read: if isAuthenticated();\n      allow write: if false; // Gerenciado via Cloud Function\n    }\n    match /Gestor_Almoxarifado/{uid} {\n      allow read: if isAuthenticated();\n      allow write: if false; // Gerenciado via Cloud Function\n    }\n    match /Gestor_Bens_Patrimoniais/{uid} {\n      allow read: if isAuthenticated();\n      allow write: if false; // Gerenciado via Cloud Function\n    }\n    match /Bolsista/{uid} {\n      allow read: if isAuthenticated();\n      allow write: if false; // Gerenciado via Cloud Function\n    }\n\n    // --- Turmas e Materias ---\n    match /Materia/{materiaId} {\n      allow read: if isAuthenticated();\n      allow write: if isAdmin();\n    }\n\n    match /Turma/{turmaId} {\n      allow read: if isAuthenticated();\n      // Professor só atualiza a própria turma, criação via Cloud Function\n      allow update: if isAdmin() || (hasRole('Professor') && resource.data.id_professor == request.auth.uid);\n      allow create: if false;\n\n      match /Alunos/{alunoId} {\n        allow read: if isAuthenticated();\n        // A inscrição é gerenciada por Cloud Function (transação)\n        allow write: if false;\n      }\n\n      match /Posts/{postId} {\n        allow read: if isAuthenticated();\n        allow create: if isAdmin() || (hasRole('Professor') && get(/databases/$(database)/documents/Turma/$(turmaId)).data.id_professor == request.auth.uid);\n        allow update, delete: if isAdmin() || (hasRole('Professor') && resource.data.id_autor == request.auth.uid);\n        \n        match /Comentarios/{comentarioId} {\n          allow read: if isAuthenticated();\n          allow create: if isAdmin() || \n            (hasRole('Professor') && get(/databases/$(database)/documents/Turma/$(turmaId)).data.id_professor == request.auth.uid) || \n            exists(/databases/$(database)/documents/Turma/$(turmaId)/Alunos/$(request.auth.uid));\n          allow update, delete: if isAdmin() || resource.data.id_autor == request.auth.uid;\n        }\n      }\n    }\n\n    // --- Patrimonio ---\n    match /Bem_Patrimonial/{itemId} {\n      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');\n      allow write: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');\n    }\n\n    match /Resumo_Bem_Patrimonial/{itemId} {\n      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');\n      allow write: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');\n    }\n\n    match /Local/{itemId} {\n      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');\n      allow write: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');\n    }\n\n    match /Requisicao_Adicao_Bem_Patrimonial/{reqId} {\n      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');\n      allow create: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');\n      allow update, delete: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');\n    }\n\n    match /Requisicao_Edicao_Bem_Patrimonial/{reqId} {\n      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');\n      allow create: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');\n      allow update, delete: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');\n    }\n\n    match /Locks_Requisicao_Patrimonio/{lockId} {\n      allow read, write: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');\n    }\n\n    match /Historico_Bem_Patrimonial/{histId} {\n      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');\n      allow write: if false; // Cloud Functions\n    }\n\n    // --- Reagentes / Almoxarifado ---\n    match /Almoxarifado/{almId} {\n      allow read: if isAuthenticated();\n      allow write: if isAdmin();\n    }\n\n    match /Gestor_Almoxarifado_x_Almoxarifado/{junctionId} {\n      allow read: if isAuthenticated();\n      allow write: if isAdmin();\n    }\n\n    match /Especificacao_Reagente/{reagenteId} {\n      allow read: if isAuthenticated();\n      allow write: if false;\n    }\n\n    match /Frasco_Reagente/{frascoId} {\n      allow read: if isAuthenticated();\n      allow write: if false;\n    }\n\n    match /Lote/{loteId} {\n      allow read: if isAuthenticated();\n      allow write: if false;\n    }\n\n    match /Contador_Codigo_Frasco/{contId} {\n      allow read: if isAuthenticated();\n      allow write: if false; // Cloud Function only\n    }\n\n    match /Emprestimo_Reagente/{empId} {\n      allow read: if isAuthenticated();\n      allow write: if false;\n    }\n\n    match /Historico_Frasco_Reagente/{histId} {\n      allow read: if isAuthenticated();\n      allow write: if false; // Cloud Function\n    }\n\n    match /Impressao_Etiqueta_Frasco/{impId} {\n      allow read: if isAuthenticated();\n      allow write: if false;\n    }\n\n    // --- Roteiros ---\n    match /Roteiro_Experimento/{roteiroId} {\n      allow read: if isAuthenticated();\n      allow create: if hasRole('Professor') && request.resource.data.id_professor == request.auth.uid;\n      allow update, delete: if isAdmin() || (hasRole('Professor') && resource.data.id_professor == request.auth.uid);\n    }\n\n    // --- Auditoria ---\n    match /Registro_de_Auditoria/{auditId} {\n      allow read: if isAdmin();\n      // Auditoria é gravada 100% pelo Backend (Cloud Functions)\n      allow write: if false; \n    }\n  }\n}\n"}]}}
