rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    match /{allPaths=**} {
      allow read, write: if false; // Deny default
    }

    match /relatorios/{fileName} {
      allow read: if true; // Liberado para o emulador ler via window.open (Nova Aba)
    }

    match /etiquetas/{fileName} {
      allow read: if true; // Liberado para o emulador ler via window.open (Nova Aba)
    }

    match /roteiros/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && 'Professor' in request.auth.token.roles
                   && request.resource.contentType.matches('application/pdf');
    }

    match /baixas_patrimoniais/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && ('Chefe_Geral' in request.auth.token.roles || 'Gestor_Bens_Patrimoniais' in request.auth.token.roles)
                   && request.resource.contentType.matches('application/pdf');
    }
  }
}
