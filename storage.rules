rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function hasRole(role) { return isAuthenticated() && request.auth.token.get('roles', []).hasAny([role]); }
    function isAdmin() { return hasRole('Chefe_Geral'); }
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function isPdf() { return request.resource.contentType == 'application/pdf'; }
    function isSizeLessThan(mb) { return request.resource.size < mb * 1024 * 1024; }

    match /{allPaths=**} { allow read, write: if false; }

    match /fotos_perfil/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow create: if (isOwner(userId) || isAdmin()) && isImage() && isSizeLessThan(5);
      allow update: if (isOwner(userId) || isAdmin()) && isImage() && isSizeLessThan(5);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /patrimonio/{itemId}/{fileName} {
      allow read: if isAuthenticated();
      allow create: if (hasRole('Gestor_Bens_Patrimoniais') || isAdmin()) && request.resource.metadata.owner == request.auth.uid && isImage() && isSizeLessThan(5);
      allow update: if (hasRole('Gestor_Bens_Patrimoniais') || isAdmin()) 
                    && (resource.metadata.owner == request.auth.uid || isAdmin())
                    && request.resource.metadata.owner == resource.metadata.owner 
                    && isImage() && isSizeLessThan(5);
      allow delete: if (hasRole('Gestor_Bens_Patrimoniais') || isAdmin()) 
                    && (resource.metadata.owner == request.auth.uid || isAdmin());
    }
    
    match /requisicoes/{reqId}/{fileName} {
      allow read: if isAuthenticated();
      allow create: if (hasRole('Professor') || hasRole('Gestor_Bens_Patrimoniais') || isAdmin()) 
                    && request.resource.metadata.owner == request.auth.uid && isImage() && isSizeLessThan(5);
      allow update: if (hasRole('Professor') || hasRole('Gestor_Bens_Patrimoniais') || isAdmin()) 
                    && (resource.metadata.owner == request.auth.uid || isAdmin())
                    && request.resource.metadata.owner == resource.metadata.owner
                    && isImage() && isSizeLessThan(5);
      allow delete: if (hasRole('Professor') || hasRole('Gestor_Bens_Patrimoniais') || isAdmin()) 
                    && (resource.metadata.owner == request.auth.uid || isAdmin());
    }

    match /baixas_patrimoniais/{itemId}/{fileName} {
      allow read: if isAuthenticated();
      allow create: if (hasRole('Gestor_Bens_Patrimoniais') || isAdmin()) && request.resource.metadata.owner == request.auth.uid && isPdf() && isSizeLessThan(10);
      allow update: if (hasRole('Gestor_Bens_Patrimoniais') || isAdmin())
                    && (resource.metadata.owner == request.auth.uid || isAdmin())
                    && request.resource.metadata.owner == resource.metadata.owner
                    && isPdf() && isSizeLessThan(10);
      allow delete: if (hasRole('Gestor_Bens_Patrimoniais') || isAdmin())
                    && (resource.metadata.owner == request.auth.uid || isAdmin());
    }

    match /roteiros/{roteiroId}/{fileName} {
      // Leitura mediada por endpoint (download assinado). Não liberar a todo autenticado.
      allow read: if false;

      // Create: professor/admin, dono do objeto, PDF estritamente menor que 15 MiB.
      allow create: if (hasRole('Professor') || isAdmin())
                    && request.resource.metadata.owner == request.auth.uid
                    && isPdf()
                    && isSizeLessThan(15);
      // Update/delete proibidos para preservar imutabilidade do objeto vinculado.
      allow update, delete: if false;
    }
  }
}
