rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Autoridade persistida M9 ---
    function hasCurrentUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/Usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/Usuarios/$(request.auth.uid)).data.ativo == true
        && get(/databases/$(database)/documents/Usuarios/$(request.auth.uid)).data.versao_permissoes is int
        && get(/databases/$(database)/documents/Usuarios/$(request.auth.uid)).data.versao_permissoes >= 0
        && request.auth.token.get('versao_permissoes', -1) is int
        && request.auth.token.get('versao_permissoes', -1)
          == get(/databases/$(database)/documents/Usuarios/$(request.auth.uid)).data.versao_permissoes;
    }

    function isKnownRole(role) {
      return [
        'Chefe_Geral',
        'Gestor_Almoxarifado',
        'Gestor_Bens_Patrimoniais',
        'Professor',
        'Aluno',
        'Bolsista'
      ].hasAny([role]);
    }

    function tokenHasRole(role) {
      return request.auth.token.get('roles', []) is list
        && request.auth.token.get('roles', []).hasAny([role]);
    }

    function hasPersistedRole(role) {
      return exists(/databases/$(database)/documents/$(role)/$(request.auth.uid))
        && get(/databases/$(database)/documents/$(role)/$(request.auth.uid)).data.id_usuario
          == request.auth.uid;
    }

    function hasRole(role) {
      return hasCurrentUser()
        && isKnownRole(role)
        && tokenHasRole(role)
        && hasPersistedRole(role);
    }

    function isAuthenticated() {
      return hasRole('Chefe_Geral')
        || hasRole('Gestor_Almoxarifado')
        || hasRole('Gestor_Bens_Patrimoniais')
        || hasRole('Professor')
        || hasRole('Aluno')
        || hasRole('Bolsista');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return hasRole('Chefe_Geral');
    }

    // --- Default Fechado ---
    match /{document=**} {
      allow read, write: if false;
    }

    // Coleções internas: deny-all já as protegia; matches explicitam a arquitetura.
    // Admin SDK não é sujeito a Security Rules.
    match /Controle_Papeis/{document=**} { allow read, write: if false; }
    match /Operacoes/{document=**} { allow read, write: if false; }
    match /Chaves_Unicas/{document=**} { allow read, write: if false; }

    // --- Usuarios ---
    match /Usuarios/{uid} {
      // Usuário lê a si mesmo, chefe lê todos
      allow read: if isOwner(uid) || isAdmin();
      // Escrita principal é feita via Cloud Function
      allow write: if false; // identidade/ativo: transação servidor (RN-ROLE)

      match /Turmas/{turmaId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false; 
      }
      match /Notificacoes/{notifId} {
        // RN-M13-01: caixa única por UID; só o destinatário autenticado lê, e o
        // documento precisa ser endereçado a ele (uid do caminho == id_destinatario).
        allow read: if isOwner(uid) && resource.data.id_destinatario == uid;
        allow write: if false; // marcação server-owned (marcarNotificacaoComoLida)
      }
    }

    // --- Coleções de Papéis (Identidade) ---
    match /Professor/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false; // Gerenciado via Cloud Function
    }
    match /Aluno/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false; // Gerenciado via Cloud Function
    }
    match /Chefe_Geral/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // Gerenciado via Cloud Function
    }
    match /Gestor_Almoxarifado/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // Gerenciado via Cloud Function
    }
    match /Gestor_Bens_Patrimoniais/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // Gerenciado via Cloud Function
    }
    match /Bolsista/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // Gerenciado via Cloud Function
    }

    // Helper M11: vínculo canônico do requerente (id_aluno == uid, id_turma == path).
    // Não usa `let` para compatibilidade com Firestore Rules v2.
    // Chamado somente no ramo colega (custo extra de get() aceito por segurança).
    function isCanonicalCurrentMember(turmaId, uid) {
      return exists(/databases/$(database)/documents/Turma/$(turmaId)/Alunos/$(uid))
        && get(/databases/$(database)/documents/Turma/$(turmaId)/Alunos/$(uid)).data.id_aluno == uid
        && get(/databases/$(database)/documents/Turma/$(turmaId)/Alunos/$(uid)).data.id_turma == turmaId;
    }

    // --- Turmas e Materias ---
    match /Materia/{materiaId} {
      allow read: if isAuthenticated();
      allow write: if false; // catálogo server-owned via gerenciarMateria
    }

    match /Turma/{turmaId} {
      allow read: if isAuthenticated();
      // Criação e status/metadados são server-owned (criarTurma/alterarStatusTurma).
      allow write: if false;

      match /Alunos/{alunoId} {
        // S11 / Rules migration-safe:
        // - self: lê o próprio vínculo sempre
        // - professor dono: lê qualquer vínculo da turma
        // - Chefe_Geral (Q13): lê qualquer vínculo
        // - colega (membro canônico): só lê se o documento alvo satisfizer a
        //   projeção mínima (id_aluno, id_turma presentes e sem campos sensíveis).
        allow get: if isAuthenticated() && (
          request.auth.uid == alunoId
          || get(/databases/$(database)/documents/Turma/$(turmaId)).data.id_professor == request.auth.uid
          || isAdmin()
          || (
            isCanonicalCurrentMember(turmaId, request.auth.uid)
            && resource.data.id_aluno == alunoId
            && resource.data.id_turma == turmaId
            && !('email' in resource.data)
            && !('numero_matricula' in resource.data)
          )
        );
        allow list: if isAuthenticated() && (
          get(/databases/$(database)/documents/Turma/$(turmaId)).data.id_professor == request.auth.uid
          || isAdmin()
        );
        // A inscrição é gerenciada por Cloud Function (transação)
        allow write: if false;
      }

      match /Posts/{postId} {
        allow read: if isAuthenticated();
        // A criação, edição e deleção de posts é feita inteiramente via Cloud Functions (posts.ts)
        allow write: if false;
        
        match /Comentarios/{comentarioId} {
          allow read: if isAuthenticated();
          // A criação, edição e deleção de comentários é feita inteiramente via Cloud Functions (posts.ts)
          allow write: if false;
        }
      }
    }

    // --- Patrimonio ---
    match /Bem_Patrimonial/{itemId} {
      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');
      allow write: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');
    }

    match /Resumo_Bem_Patrimonial/{itemId} {
      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');
      allow write: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');
    }

    match /Local/{itemId} {
      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');
      // Criação/edição server-owned (gerenciarLocal); propagação por trigger.
      allow write: if false;
    }

    match /Requisicao_Adicao_Bem_Patrimonial/{reqId} {
      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');
      allow create: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');
      allow update, delete: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');
    }

    match /Requisicao_Edicao_Bem_Patrimonial/{reqId} {
      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');
      allow create: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');
      allow update, delete: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');
    }

    match /Locks_Requisicao_Patrimonio/{lockId} {
      allow read, write: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');
    }

    match /Historico_Bem_Patrimonial/{histId} {
      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');
      allow write: if false; // Cloud Functions
    }

    // --- Reagentes / Almoxarifado ---
    match /Substancia_Quimica/{substId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Functions
    }

    match /Resumo_Reagente/{resumoId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /Almoxarifado/{almId} {
      allow read: if isAuthenticated();
      // Criação/status/gestores server-owned (gerenciarAlmoxarifado).
      allow write: if false;
    }

    match /Gestor_Almoxarifado_x_Almoxarifado/{junctionId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /Especificacao_Reagente/{reagenteId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /Frasco_Reagente/{frascoId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /Lote/{loteId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /Contador_Codigo_Frasco/{contId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function only
    }

    match /Emprestimo_Reagente/{empId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /Historico_Frasco_Reagente/{histId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function
    }

    match /Impressao_Etiqueta_Frasco/{impId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // --- Roteiros ---
    match /Roteiro_Experimento/{roteiroId} {
      allow read: if isAuthenticated();
      allow create: if hasRole('Professor') && request.resource.data.id_professor == request.auth.uid;
      allow update, delete: if isAdmin() || (hasRole('Professor') && resource.data.id_professor == request.auth.uid);
    }

    // --- Auditoria ---
    match /Registro_de_Auditoria/{auditId} {
      allow read: if isAdmin();
      // Auditoria é gravada 100% pelo Backend (Cloud Functions)
      allow write: if false; 
    }
  }
}
