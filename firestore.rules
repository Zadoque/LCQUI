rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funções Auxiliares ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      // A role é passada como Custom Claim no token na array 'roles'
      return isAuthenticated() && request.auth.token.get('roles', []).hasAny([role]);
    }

    function isAdmin() {
      return hasRole('Chefe_Geral');
    }

    // --- Default Fechado ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Usuarios ---
    match /Usuarios/{uid} {
      // Usuário lê a si mesmo, chefe lê todos
      allow read: if isOwner(uid) || isAdmin();
      // Escrita principal é feita via Cloud Function
      allow write: if isOwner(uid) || isAdmin();

      match /Turmas/{turmaId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false; 
      }
      match /Notificacoes/{notifId} {
        allow read: if isOwner(uid);
        allow update, delete: if isOwner(uid); 
        allow create: if false; // Backend quem cria
      }
    }

    // --- Coleções de Papéis (Identidade) ---
    match /Professor/{uid} {
      allow read: if isAuthenticated();
      allow write: if false; // Gerenciado via Cloud Function
    }
    match /Aluno/{uid} {
      allow read: if isAuthenticated();
      allow write: if false; // Gerenciado via Cloud Function
    }
    match /Chefe_Geral/{uid} {
      allow read: if isAuthenticated();
      allow write: if false; // Gerenciado via Cloud Function
    }
    match /Gestor_Almoxarifado/{uid} {
      allow read: if isAuthenticated();
      allow write: if false; // Gerenciado via Cloud Function
    }
    match /Gestor_Bens_Patrimoniais/{uid} {
      allow read: if isAuthenticated();
      allow write: if false; // Gerenciado via Cloud Function
    }
    match /Bolsista/{uid} {
      allow read: if isAuthenticated();
      allow write: if false; // Gerenciado via Cloud Function
    }

    // --- Turmas e Materias ---
    match /Materia/{materiaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /Turma/{turmaId} {
      allow read: if isAuthenticated();
      // Professor e admin/chefe podem criar/alterar
      allow write: if isAdmin() || hasRole('Professor');

      match /Alunos/{alunoId} {
        allow read: if isAuthenticated();
        // O próprio aluno pode se inscrever (write = create), e admin/professor gerenciam
        allow write: if isAdmin() || hasRole('Professor') || isOwner(alunoId);
      }

      match /Posts/{postId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || hasRole('Professor');
        
        match /Comentarios/{comentarioId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated();
        }
      }
    }

    // --- Patrimonio ---
    match /Bem_Patrimonial/{itemId} {
      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');
      allow write: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');
    }

    match /Resumo_Bem_Patrimonial/{itemId} {
      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');
      allow write: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');
    }

    match /Local/{itemId} {
      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');
      allow write: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');
    }

    match /Requisicao_Adicao_Bem_Patrimonial/{reqId} {
      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');
      allow create: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');
      allow update, delete: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');
    }

    match /Requisicao_Edicao_Bem_Patrimonial/{reqId} {
      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');
      allow create: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais') || hasRole('Professor');
      allow update, delete: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');
    }

    match /Locks_Requisicao_Patrimonio/{lockId} {
      allow read, write: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');
    }

    match /Historico_Bem_Patrimonial/{histId} {
      allow read: if isAdmin() || hasRole('Gestor_Bens_Patrimoniais');
      allow write: if false; // Cloud Functions
    }

    // --- Reagentes / Almoxarifado ---
    match /Almoxarifado/{almId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /Gestor_Almoxarifado_x_Almoxarifado/{junctionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /Especificacao_Reagente/{reagenteId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole('Gestor_Almoxarifado');
    }

    match /Frasco_Reagente/{frascoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole('Gestor_Almoxarifado');
    }

    match /Lote/{loteId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole('Gestor_Almoxarifado');
    }

    match /Contador_Codigo_Frasco/{contId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function only
    }

    match /Emprestimo_Reagente/{empId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole('Gestor_Almoxarifado') || hasRole('Professor');
    }

    match /Historico_Frasco_Reagente/{histId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function
    }

    match /Impressao_Etiqueta_Frasco/{impId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole('Gestor_Almoxarifado');
    }

    // --- Roteiros ---
    match /Roteiro_Experimento/{roteiroId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole('Professor');
    }

    // --- Auditoria ---
    match /Registro_de_Auditoria/{auditId} {
      allow read: if isAdmin();
      // Auditoria é gravada 100% pelo Backend (Cloud Functions)
      allow write: if false; 
    }
  }
}
